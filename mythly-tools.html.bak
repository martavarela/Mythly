<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tools — Mythly</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='75' font-size='90' text-anchor='middle' x='50'>⚡</text></svg>">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--ink:#244832;--purple:#6b2fa3;--blue:#3d5fa8;--lilac:#efe7ff;--panel:rgba(239,231,255,.78);--field:rgba(224,239,255,.82);--line:rgba(107,47,163,.18);--text-size:1rem}
    *{box-sizing:border-box}
    html{min-height:100%;background:linear-gradient(135deg,rgba(224,239,255,.88),rgba(239,231,255,.88)),url('mountolympus.jpg') center/cover fixed no-repeat;background-color:var(--lilac)}
    body{margin:0;min-height:100vh;color:var(--ink);font-family:Georgia,"Times New Roman",serif;font-size:var(--text-size);line-height:1.55}
    body.high-contrast{--ink:#162b4d;--panel:#f7f4ff;--field:#e8f5f3;--line:#514a78;background:#e8efff;color:#162b4d}
    html:has(body.high-contrast){background:#e8efff}
    body.high-contrast .site-header .header-top{background:#f7edda;border:2px solid #514a78;box-shadow:none;color:#162b4d}
    body.high-contrast .subtitle{background:#d9f0e1;border:2px solid #514a78;box-shadow:none;color:#162b4d}
    body.high-contrast .tool,body.high-contrast .comparison,body.high-contrast .scenario-label,body.high-contrast .result,body.high-contrast .judge-note{background:#f7f4ff;border:2px solid #514a78;box-shadow:none;color:#162b4d}
    body.high-contrast .tool h3,body.high-contrast .tool p,body.high-contrast .intro h2,body.high-contrast .intro p,body.high-contrast label,body.high-contrast .comparison label,body.high-contrast .scenario-label,body.high-contrast .judge-note,body.high-contrast .top-nav a{color:#162b4d}
    body.high-contrast button{background:#5b2b8d;color:#fff;border:2px solid #3c1d61}
    body.high-contrast button.secondary{background:#2f668f;color:#fff;border:2px solid #204863}
    body.high-contrast select,body.high-contrast input,body.high-contrast textarea{background:#e8f5f3;color:#162b4d;border:2px solid #467b7b;box-shadow:none}
    body.high-contrast .probability-bar{background:#e8f5f3;border:2px solid #467b7b}
    body.high-contrast .probability-fill{background:#5b2b8d}
    body.reduced-motion *,body.reduced-motion *::before,body.reduced-motion *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
    .site-header{width:min(1100px,calc(100% - 2rem));margin:1rem auto 0}
    .header-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.5rem;background:rgba(245,230,200,.98);border-radius:.75rem .75rem 0 0}
    h1{margin:0;font:600 clamp(2rem,6vw,3.5rem)/1 'Cormorant Garamond',serif;letter-spacing:.15em;text-transform:uppercase}
    .top-nav{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:1.2rem}.top-nav a{color:var(--ink);font:500 clamp(1rem,2.5vw,1.3rem) 'Cormorant Garamond',serif;letter-spacing:.1em;text-decoration:none}.top-nav a:hover{text-decoration:underline}
    .subtitle{padding:.85rem 1rem;text-align:center;background:rgba(220,245,225,.98);border-radius:0 0 .75rem .75rem}.subtitle p{margin:0;font:500 clamp(1.15rem,3vw,1.8rem) 'Cormorant Garamond',serif}
    main{width:min(1100px,calc(100% - 2rem));margin:2rem auto 4rem}.intro{text-align:center;margin-bottom:1.5rem}.intro h2{font:500 clamp(2rem,5vw,3rem) 'Cormorant Garamond',serif;margin:.25rem 0}.intro p{margin:.25rem auto;max-width:650px}
    .layout{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.tool{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:1.25rem;box-shadow:0 10px 24px rgba(38,61,84,.1)}.tool.wide{grid-column:1/-1}.tool h3{margin:0 0 .4rem;font:600 1.8rem 'Cormorant Garamond',serif}.tool p{margin:.4rem 0}.controls{display:flex;flex-wrap:wrap;gap:.55rem;align-items:center;margin-top:.8rem}button,select,input,textarea{font:inherit}button{border:0;border-radius:.5rem;padding:.55rem .85rem;background:var(--purple);color:#fff;cursor:pointer}button:hover{filter:brightness(1.1)}button.secondary{background:var(--blue)}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #ff8fbe;outline-offset:2px}select,input,textarea{border:1px solid #b9a9d5;border-radius:.45rem;padding:.5rem;background:var(--field);color:#244832}label{display:flex;align-items:center;gap:.4rem}
    #daily-tool,#achievement-tool,#suggestion-tool{display:none}
    .comparison{display:grid;grid-template-columns:1fr 1fr;gap:.85rem;padding:1rem;background:linear-gradient(135deg,rgba(220,245,225,.82),rgba(224,239,255,.82));border:1px solid rgba(61,95,168,.18);border-radius:.8rem}.comparison label,.scenario-label{display:flex;flex-direction:column;gap:.3rem;font-weight:600;color:#3d2863}.comparison select,.scenario-label select{width:100%;appearance:none;background:linear-gradient(135deg,#e7f3f2,#efe7ff);border:1px solid #9bc5c3;border-radius:.55rem;color:#244832;box-shadow:inset 0 1px 2px rgba(61,95,168,.08);background-image:linear-gradient(45deg,transparent 50%,#6b2fa3 50%),linear-gradient(135deg,#6b2fa3 50%,transparent 50%);background-position:calc(100% - 15px) calc(1em + 2px),calc(100% - 10px) calc(1em + 2px);background-size:5px 5px,5px 5px;background-repeat:no-repeat;padding-right:2rem}.scenario-label{display:block;margin-top:.85rem;padding:.85rem;background:linear-gradient(135deg,rgba(239,231,255,.9),rgba(255,209,232,.42));border:1px solid rgba(107,47,163,.16);border-radius:.8rem}.compare-table{width:100%;border-collapse:collapse;margin-top:1rem}.compare-table th,.compare-table td{text-align:left;padding:.45rem;border-bottom:1px solid var(--line)}.winner{font-weight:700;color:var(--purple)}
    #personality-question{display:flex;flex-direction:column;gap:.7rem;margin-top:.9rem}#personality-question strong{margin-bottom:.1rem}#personality-question button{width:100%;margin:0;text-align:left}
    .scenario-label{display:block;margin-top:.9rem}.scenario-label select{width:100%;margin-top:.3rem}.probability{margin-top:1rem}.probability-row{display:grid;grid-template-columns:6.5rem 1fr 3.5rem;gap:.55rem;align-items:center;margin:.55rem 0}.probability-bar{height:.7rem;border-radius:99px;background:#dcefe7;overflow:hidden}.probability-fill{height:100%;border-radius:inherit;background:linear-gradient(90deg,#6b2fa3,#3d8f9a)}.judge-note{margin-top:.9rem;padding:.7rem .8rem;border-radius:.6rem;background:rgba(224,239,255,.7);font-size:.88rem;color:#31556b}.judge-note strong{color:#3d2863}
    .tournament-link{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:1rem;padding:1rem;border-radius:.8rem;background:linear-gradient(135deg,rgba(255,209,232,.58),rgba(224,239,255,.82));border:1px solid rgba(107,47,163,.18)}.tournament-link p{margin:0}.tournament-link a{flex:0 0 auto;color:#fff;text-decoration:none;background:linear-gradient(135deg,var(--purple),var(--blue));padding:.6rem .85rem;border-radius:.5rem;font-weight:600}.tournament-link a:hover{filter:brightness(1.1)}
    .result,.daily-card,.achievement{margin-top:1rem;padding:1rem;border-radius:.6rem;background:rgba(220,245,225,.7)}.daily-card h4{margin:0;font:600 1.5rem 'Cormorant Garamond',serif}.achievement-list{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem;margin-top:1rem}.achievement{margin:0;opacity:.45}.achievement.unlocked{opacity:1;background:#ffd1e8}.achievement strong{display:block}.suggestions{margin-top:1rem;padding-left:1.2rem}.suggestions li{margin:.35rem 0}
    @media(max-width:760px){.header-top{align-items:flex-start;flex-direction:column}.top-nav{justify-content:flex-start}.layout{grid-template-columns:1fr}.tool.wide{grid-column:auto}.comparison{grid-template-columns:1fr}.achievement-list{grid-template-columns:1fr 1fr}}
  </style>
</head>
<body>
  <header class="site-header">
    <div class="header-top"><h1>Mythly</h1><nav class="top-nav" aria-label="Main navigation"><a href="home.html">Home</a><a href="characters.html">Characters</a><a href="quizzes.html">Quizzes</a><a href="myths.html">Myths</a><a href="fun.html">Fun</a><a href="about.html">About</a></nav></div>
    <div class="subtitle"><p>Explore, compare, and discover Greek mythology</p></div>
  </header>
  <main>
    <section class="intro"><h2>Tools</h2><p>Trace divine relationships, find your Olympian, compare characters, and shape your reading experience.</p></section>
    <div class="layout">
      <section class="tool" id="personality-tool"><h3>Olympian Personality Quiz</h3><p>Answer three quick questions to find your divine match.</p><div id="personality-question"></div><div class="controls"><button id="personality-next" type="button">Start quiz</button></div><div class="result" id="personality-result" hidden aria-live="polite"></div></section>
      <section class="tool" id="comparison-tool"><h3>Character Comparison</h3><p>Choose two characters and decide what kind of contest they are entering.</p><div class="comparison"><label>First<select id="compare-one"></select></label><label>Second<select id="compare-two"></select></label></div><label class="scenario-label">Contest type<select id="compare-scenario"><option value="fight">Full fight</option><option value="wits">Battle of the wits</option><option value="strength">Strength battle</option><option value="magic">Magic contest</option><option value="influence">Influence challenge</option><option value="endurance">Endurance trial</option><option value="leadership">Leadership challenge</option></select></label><div id="comparison-result" class="result" aria-live="polite"></div></section>
      <section class="tool" id="tournament-tool"><h3>Who Would Win?</h3><p>Build a tournament with your own gods and heroes, then choose the contest and bracket style.</p><div class="tournament-link"><p>Choose the entrants, format, and contest type.</p><a href="who-would-win.html">Open tournament</a></div></section>
      <section class="tool" id="daily-tool"><h3>Daily Myth</h3><p>A small story to return to each day.</p><div class="daily-card"><h4 id="daily-title"></h4><p id="daily-text"></p></div><div class="controls"><button class="secondary" id="daily-another" type="button">Read another</button></div></section>
      <section class="tool" id="achievement-tool"><h3>Achievements</h3><p>Your discoveries are saved on this device.</p><div class="achievement-list" id="achievement-list"></div></section>
      <section class="tool" id="accessibility-tool"><h3>Accessibility</h3><p>Adjust the reading experience.</p><div class="controls"><label><input id="large-text" type="checkbox"> Larger text</label><label><input id="high-contrast" type="checkbox"> Monochrome</label><label><input id="reduced-motion" type="checkbox"> Reduce motion</label></div></section>
      <section class="tool wide" id="suggestion-tool"><h3>Suggest a Myth</h3><p>Tell Mythly what you would like to see next.</p><form id="suggestion-form"><label for="suggestion-input">Your idea</label><textarea id="suggestion-input" rows="3" maxlength="240" required placeholder="A hero, monster, place, or story..."></textarea><div class="controls"><button type="submit">Save suggestion</button><span id="suggestion-status" aria-live="polite"></span></div></form><ul class="suggestions" id="suggestions-list"></ul></section>
    </div>
  </main>
  <script>
    (function(){
      var figures={zeus:{name:'Zeus',parents:'Kronos and Rhea',links:'Father of Athena, Apollo, Artemis, Hermes, Dionysus, and Persephone.'},hera:{name:'Hera',parents:'Kronos and Rhea',links:'Wife of Zeus and mother of Ares and Hephaestus.'},athena:{name:'Athena',parents:'Zeus and Metis',links:'Goddess of wisdom and strategic warfare.'},poseidon:{name:'Poseidon',parents:'Kronos and Rhea',links:'Brother of Zeus and Hades; father of Triton.'},hades:{name:'Hades',parents:'Kronos and Rhea',links:'Brother of Zeus and Poseidon; husband of Persephone.'},aphrodite:{name:'Aphrodite',parents:'Zeus and Dione, or Ouranos in Hesiodic tradition',links:'Mother of Eros in later myths.'},ares:{name:'Ares',parents:'Zeus and Hera',links:'Brother of Athena and Hephaestus.'},apollo:{name:'Apollo',parents:'Zeus and Leto',links:'Twin brother of Artemis.'},artemis:{name:'Artemis',parents:'Zeus and Leto',links:'Twin sister of Apollo.'},hermes:{name:'Hermes',parents:'Zeus and Maia',links:'Messenger of the gods.'},demeter:{name:'Demeter',parents:'Kronos and Rhea',links:'Mother of Persephone.'},persephone:{name:'Persephone',parents:'Zeus and Demeter',links:'Queen of the Underworld with Hades.'},hestia:{name:'Hestia',parents:'Kronos and Rhea',links:'Eldest Olympian sister of Zeus, Hera, Poseidon, Hades, and Demeter.'},hephaestus:{name:'Hephaestus',parents:'Zeus and Hera, or Hera alone in Hesiod',links:'Divine smith of Olympus.'},dionysus:{name:'Dionysus',parents:'Zeus and Semele',links:'God of wine, theatre, and celebration.'}};
      var personality=[{question:'What would you protect first?',answers:[['A city and its people','athena'],['A sacred promise','hera'],['A wild forest','artemis'],['A feast for everyone','dionysus']]},{question:'What is your best strength?',answers:[['Clear strategy','athena'],['Steady leadership','zeus'],['Empathy','demeter'],['Clever improvisation','hermes']]},{question:'Choose a place to spend the evening.',answers:[['A quiet library','athena'],['A bright shoreline','apollo'],['A garden in bloom','persephone'],['A lively festival','dionysus']]}];
      var daily=[['The golden apple','Eris threw a golden apple into a divine wedding, setting three goddesses against one another.'],['The lyre','Hermes invented the lyre as a baby and traded it to Apollo after stealing his cattle.'],['The laurel','Apollo chased Daphne, who became a laurel tree; he made its leaves sacred.'],['The pomegranate','Persephone ate pomegranate seeds in the Underworld, binding her to Hades for part of every year.'],['The fire-bringer','Prometheus gave fire to humanity and paid a severe price for defying Zeus.']];
      var achievements=[['quiz','Olympian Match','Complete the personality quiz.'],['compare','Rivalry Ready','Compare two characters.'],['daily','Daily Devotee','Read a daily myth.'],['suggest','Voice of the People','Submit a suggestion.']];
      var state=JSON.parse(localStorage.getItem('mythly-tools-state')||'{}'); state.unlocked=state.unlocked||{};
      function save(){localStorage.setItem('mythly-tools-state',JSON.stringify(state));renderAchievements();}
      function unlock(key){if(!state.unlocked[key]){state.unlocked[key]=true;save();}}
      function renderAchievements(){var el=document.getElementById('achievement-list');el.innerHTML='';achievements.forEach(function(item){var card=document.createElement('div');card.className='achievement'+(state.unlocked[item[0]]?' unlocked':'');card.innerHTML='<strong>'+item[1]+'</strong><span>'+item[2]+'</span>';el.appendChild(card);});}
      var questionIndex=-1,scores={};function renderQuestion(){var q=document.getElementById('personality-question');if(questionIndex<0){q.innerHTML='';return;}if(questionIndex>=personality.length){var winner=Object.keys(scores).sort(function(a,b){return scores[b]-scores[a];})[0];document.getElementById('personality-result').hidden=false;document.getElementById('personality-result').textContent='You match '+figures[winner].name+': '+figures[winner].links;document.getElementById('personality-next').textContent='Try again';document.getElementById('personality-next').hidden=false;unlock('quiz');return;}var item=personality[questionIndex];q.innerHTML='<strong>'+item.question+'</strong>';item.answers.forEach(function(answer){var button=document.createElement('button');button.type='button';button.className='secondary';button.textContent=answer[0];button.addEventListener('click',function(){scores[answer[1]]=(scores[answer[1]]||0)+1;questionIndex+=1;renderQuestion();});q.appendChild(button);});}
    document.getElementById('personality-next').addEventListener('click',function(){if(questionIndex>=personality.length||questionIndex<0){questionIndex=0;scores={};document.getElementById('personality-result').hidden=true;this.hidden=true;renderQuestion();}});
      var comparisonStats={zeus:{strength:9.8,wits:7.4,magic:9.7,influence:9.9,endurance:9.1,leadership:9.8},hera:{strength:7.2,wits:8.3,magic:8.1,influence:9.6,endurance:8.2,leadership:9.1},athena:{strength:7.4,wits:9.9,magic:8.4,influence:9.2,endurance:8.1,leadership:9.7},poseidon:{strength:9.2,wits:7.1,magic:9.3,influence:8.8,endurance:9.8,leadership:8.2},hades:{strength:8.4,wits:8.2,magic:9.8,influence:8.1,endurance:9.2,leadership:7.3},aphrodite:{strength:5.1,wits:8.4,magic:9.2,influence:9.8,endurance:7.2,leadership:7.1},ares:{strength:9.9,wits:5.3,magic:6.2,influence:7.1,endurance:9.7,leadership:8.1},apollo:{strength:7.3,wits:8.1,magic:8.5,influence:8.2,endurance:8.4,leadership:8.3},artemis:{strength:8.2,wits:8.5,magic:8.1,influence:7.3,endurance:9.9,leadership:8.4},hermes:{strength:6.2,wits:9.1,magic:8.2,influence:8.4,endurance:8.1,leadership:7.4},demeter:{strength:6.1,wits:8.2,magic:8.3,influence:8.1,endurance:9.3,leadership:8.2},persephone:{strength:5.3,wits:8.1,magic:9.1,influence:8.2,endurance:8.3,leadership:7.2},hestia:{strength:4.2,wits:9.2,magic:7.2,influence:8.3,endurance:8.4,leadership:8.1},hephaestus:{strength:9.7,wits:7.2,magic:8.2,influence:7.2,endurance:9.6,leadership:7.1},dionysus:{strength:6.3,wits:6.2,magic:8.1,influence:8.3,endurance:8.2,leadership:7.2}};
      var contestNames={fight:'Full fight',wits:'Battle of the wits',strength:'Strength battle',magic:'Magic contest',influence:'Influence challenge',endurance:'Endurance trial',leadership:'Leadership challenge'};
      var compareKeys=Object.keys(figures);['compare-one','compare-two'].forEach(function(id,index){var select=document.getElementById(id);compareKeys.forEach(function(key){var option=document.createElement('option');option.value=key;option.textContent=figures[key].name;select.appendChild(option);});select.selectedIndex=index;select.addEventListener('change',renderComparison);});document.getElementById('compare-scenario').addEventListener('change',renderComparison);
      function renderComparison(){var oneKey=document.getElementById('compare-one').value,twoKey=document.getElementById('compare-two').value,scenario=document.getElementById('compare-scenario').value,one=figures[oneKey],two=figures[twoKey],oneStats=comparisonStats[oneKey],twoStats=comparisonStats[twoKey],oneScore=0,twoScore=0,scenarioName=contestNames[scenario]||contestNames.fight;if(scenario==='wits'){oneScore=oneStats.wits;twoScore=twoStats.wits;}else if(scenario==='strength'){oneScore=oneStats.strength;twoScore=twoStats.strength;}else if(scenario==='magic'){oneScore=oneStats.magic;twoScore=twoStats.magic;}else if(scenario==='influence'){oneScore=oneStats.influence;twoScore=twoStats.influence;}else if(scenario==='endurance'){oneScore=oneStats.endurance;twoScore=twoStats.endurance;}else if(scenario==='leadership'){oneScore=oneStats.leadership;twoScore=twoStats.leadership;}else{oneScore=oneStats.strength*.65+oneStats.wits*.35;twoScore=twoStats.strength*.65+twoStats.wits*.35;}var total=oneScore+twoScore,oneChance=Number((oneScore/total*100).toFixed(1)),twoChance=Number((100-oneChance).toFixed(1)),confidence=Number(Math.min(93,76+Math.abs(oneScore-twoScore)*3).toFixed(1)),leader=oneChance===twoChance?'This is an even match.':(oneChance>twoChance?one.name+' has the edge.':two.name+' has the edge.');document.getElementById('comparison-result').innerHTML='<strong>'+scenarioName+'</strong><div class="probability"><div class="probability-row"><span>'+one.name+'</span><div class="probability-bar"><div class="probability-fill" style="width:'+oneChance+'%"></div></div><strong>'+oneChance.toFixed(1)+'%</strong></div><div class="probability-row"><span>'+two.name+'</span><div class="probability-bar"><div class="probability-fill" style="width:'+twoChance+'%"></div></div><strong>'+twoChance.toFixed(1)+'%</strong></div></div><p><strong>AI judge:</strong> '+leader+' '+one.name+' is rated '+oneScore.toFixed(1)+' and '+two.name+' '+twoScore.toFixed(1)+' for this contest.</p><div class="judge-note"><strong>Judge confidence:</strong> '+confidence.toFixed(1)+'% based on the selected characters\' profiles and contest rules.</div>';unlock('compare');}renderComparison();
      var dailyIndex=new Date().getDate()%daily.length;function showDaily(index){document.getElementById('daily-title').textContent=daily[index][0];document.getElementById('daily-text').textContent=daily[index][1];unlock('daily');}showDaily(dailyIndex);document.getElementById('daily-another').addEventListener('click',function(){dailyIndex=(dailyIndex+1)%daily.length;showDaily(dailyIndex);});
      function loadAccessibility(){var settings=JSON.parse(localStorage.getItem('mythly-accessibility')||'{}');document.getElementById('large-text').checked=!!settings.large;document.getElementById('high-contrast').checked=!!settings.contrast;document.getElementById('reduced-motion').checked=!!settings.motion;document.documentElement.style.setProperty('--text-size',settings.large?'1.15rem':'1rem');document.body.classList.toggle('high-contrast',!!settings.contrast);document.body.classList.toggle('reduced-motion',!!settings.motion);}
      function saveAccessibility(){var settings={large:document.getElementById('large-text').checked,contrast:document.getElementById('high-contrast').checked,motion:document.getElementById('reduced-motion').checked};localStorage.setItem('mythly-accessibility',JSON.stringify(settings));loadAccessibility();}
      ['large-text','high-contrast','reduced-motion'].forEach(function(id){document.getElementById(id).addEventListener('change',saveAccessibility);});loadAccessibility();
      var suggestionForm=document.getElementById('suggestion-form');function renderSuggestions(){var list=document.getElementById('suggestions-list');var items=JSON.parse(localStorage.getItem('mythly-suggestions')||'[]');var recentItems=items.slice(-5).reverse();list.innerHTML=recentItems.map(function(item){return '<li>'+item.replace(/[&<>]/g,function(char){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[char];})+'</li>';}).join('');}suggestionForm.addEventListener('submit',function(event){event.preventDefault();var input=document.getElementById('suggestion-input');var value=input.value.trim();if(!value)return;var items=JSON.parse(localStorage.getItem('mythly-suggestions')||'[]');items.push(value);localStorage.setItem('mythly-suggestions',JSON.stringify(items));input.value='';document.getElementById('suggestion-status').textContent='Suggestion saved on this device.';renderSuggestions();unlock('suggest');});renderSuggestions();renderAchievements();
    }());
  </script>
</body>
</html>
